# MindGraph PA Environment Configuration

# Host and Port
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Timezone (e.g. Europe/London, America/New_York, UTC)
USER_TIMEZONE=Europe/London

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OpenRouter API (Access Claude 3.5/3.7, DeepSeek R1, Llama 3.3, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
LLM_PROVIDER=auto  # "auto" (uses OpenRouter with Gemini fallback), "gemini", or "openrouter"

# Daily Briefing Schedule (24-hour format HH:MM)
MORNING_BRIEFING_TIME=08:00
EVENING_BRIEFING_TIME=19:30

# Google Calendar Integration
CALENDAR_AUTO_SYNC=true
GOOGLE_CLIENT_SECRETS_FILE=data/credentials.json
GOOGLE_TOKEN_FILE=data/token.json
